# ============================================================================
# SÉJOURA — Variables d'environnement
# Dupliquez ce fichier en `.env.local` (local) et configurez les mêmes
# variables sur Vercel (Settings → Environment Variables) pour Production.
#
# IMPORTANT
#   • Les variables préfixées NEXT_PUBLIC_ sont injectées dans le bundle
#     NAVIGATEUR au moment du BUILD. Sans elles (ou après modification),
#     un REDEPLOY est requis ; un hard refresh (Ctrl+Shift+R) peut être
#     nécessaire pour purger l'ancien bundle.
#   • N'exposez JAMAIS SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL,
#     WAVE_API_KEY ni WAVE_WEBHOOK_SECRET côté client : elles ne doivent
#     exister que côté serveur (Vercel, sans préfixe NEXT_PUBLIC_).
# ============================================================================

# ── Supabase : URL du projet (client + serveur) ──────────────────────────────
# Dashboard Supabase → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# ── Supabase : clé publique (client + middleware) ────────────────────────────
# Une seule des deux suffit ; la publishable est prioritaire si les deux
# sont définies.
#   • Format « anon public »      : eyJhbGciOi...
#   • Format « publishable key »  : sb_publishable_...
# Dashboard Supabase → Settings → API → Project API keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Supabase : clé service_role (SERVEUR UNIQUEMENT, SECRÈTE) ────────────────
# Bypasse RLS pour les opérations admin (webhooks, onboarding, cron).
# À NE JAMAIS mettre dans un composant client, ni dans ce fichier versionné.
# Dashboard Supabase → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# ── Base de données (migrations uniquement) ──────────────────────────────────
# Utilisée par `npm run db:push` (scripts/db-push.mjs). Jamais côté client.
# Format : postgresql://postgres:<motdepasse>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=

# ── Optionnel : flux automatisé Wave Checkout ─────────────────────────────────
# Clé API Wave, côté serveur uniquement (README.md section paiement Wave).
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=

# ── Optionnel : pepper pour le hachage des PIN employés ──────────────────────
# Sert à dériver les PIN (api/employee-pin). Fourni en secours par défaut.
PIN_PEPPER=

# ── Optionnel : alertes Telegram pour le Super Admin ─────────────────────────
# Envoyées côté serveur via src/lib/telegram.ts (utilitaire partagé) à chaque :
#   • nouvelle suggestion dans la boîte à idées (/api/feature-requests/notify)
#   • nouvelle demande de validation d'abonnement d'une résidence
#     (/api/subscription/notify-payment)
#   • nouvelle inscription d'établissement (/api/register)
#   • paiement Wave automatique reçu (/api/webhooks/wave)
#   • abonnement passé en 'expired' (outbox telegram_alerts + Vercel cron
#     /api/cron/telegram-alerts, cf. migration 20260828_subscription_expired_telegram.sql)
# Sans configuration, les alertes sont simplement ignorées (aucune erreur
# remontée aux utilisateurs).
#   • Token du bot Telegram (fourni par @BotFather)
TELEGRAM_BOT_TOKEN=
#   • Identifiant du chat destinataire (ex. un canal privé)
TELEGRAM_CHAT_ID=
#   • Lien du message → console admin (deep-link vers la section concernée).
#     Défaut selon la route : https://app.sejoura.com/admin?next=/admin/ideas
#     pour les suggestions, https://app.sejoura.com/admin?next=/admin/sejour
#     pour les abonnements. Le lien /admin ouvre la page de connexion Super
#     Admin (mot de passe seul), puis renvoie vers la section ciblée.
TELEGRAM_ADMIN_URL=

# ── Optionnel : compte Super Admin pour la connexion /admin ───────────────────
# Adresse e-mail du compte Supabase Auth identifié comme Super Admin (rôle
# 'super_admin' dans la table users). La page /admin ne demande que le mot de
# passe ; l'e-mail est résolu côté serveur via cette variable. Si absente, le
# premier compte users.role='super_admin' de la base est utilisé.
SUPER_ADMIN_EMAIL=
# Mot de passe du compte Super Admin, utilisé uniquement par le script
# `npm run admin:create` (scripts/create-super-admin.mjs) pour créer/mettre à
# jour le compte. Jamais lu par l'application elle-même.
SUPER_ADMIN_PASSWORD=

# ── Optionnel : secret du Vercel Cron (alerte abonnement expiré) ─────────────
# Utilisé par /api/cron/telegram-alerts (outbox des événements déclenchés en
# base). Vercel injecte automatiquement l'en-tête
# "Authorization: Bearer <CRON_SECRET>" sur les jobs Cron si la variable est
# définie (Dashboard Vercel → Settings → Environment Variables → CRON_SECRET).
CRON_SECRET=
